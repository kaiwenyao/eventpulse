# Copy to .env and adjust. Rotating these two secrets invalidates issued tokens.
# Real deployments must replace both dev defaults; startup does not enforce this.
SECRET_KEY=change-me-please-32-bytes-minimum-secret!!
DB_PASSWORD=eventpulse
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI service (Python, FastAPI + LangChain) ----
# Set a real LLM key to enable the AI assistant; without it every AI endpoint
# answers "AI unavailable" and normal business flows keep working.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional OpenAI-compatible endpoint override:
# MUST include the API prefix (e.g. https://host/v1); ai-service calls
# {LLM_BASE_URL}/chat/completions. Leave empty to use the default OpenAI API.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# Reasoning models spend thinking tokens from this budget; keep it >= 4096.
LLM_MAX_OUTPUT_TOKENS=4096
# Spring Boot <-> ai-service mutual credentials (change in real deployments):
AI_SERVICE_TOKEN=dev-ai-service-token
AI_INTERNAL_TOKEN=dev-ai-internal-token
AI_ENABLED=true
# 两条链的温度分开：文案助手要稳定可解析的结构化输出，发现助手要自然的措辞。
LLM_TEMPERATURE_COPY=0.2
LLM_TEMPERATURE_DISCOVERY=0.7
# 每日 token 预算（0 = 关闭）。与「次/分钟」限流互补：限流挡短时间刷调用，
# 预算挡长尾的成本失控。语义是「先检查、后记账」，跨过阈值的那一次仍会放行。
AI_DAILY_TOKEN_BUDGET_USER=200000
AI_DAILY_TOKEN_BUDGET_GLOBAL=0
# 上游失败时按这个值记账：失败的那一轮真的烧了 token，但 502 里没有 usage。
AI_FAILURE_TOKEN_PENALTY=2000
# AI 结果缓存（需要 Redis；没有 Redis 时无论如何都不缓存）。
# 换模型后最多 AI_CACHE_IMPROVE_TTL_SECONDS 内仍可能返回旧模型的文案。
AI_CACHE_ENABLED=true
AI_CACHE_IMPROVE_TTL_SECONDS=3600
AI_CACHE_DISCOVERY_TTL_SECONDS=120
# 会话与调用日志的保留期（天，0 = 不清理），由 worker 分批删除。
AI_RETENTION_DAYS=90
AI_REQUEST_LOG_RETENTION_DAYS=180
# 文案助手单独一条读超时：它只有一次受 LLM_TIMEOUT_SECONDS 约束的调用，
# 跟发现助手共用 90s 只会让 Tomcat 线程白占。
AI_READ_TIMEOUT_IMPROVE=35000
# 连续多少次「传输层」故障后熔断（0 = 关闭）。应用层 502（模型没吐好）不计入。
AI_BREAKER_FAILURE_THRESHOLD=5
AI_BREAKER_OPEN_SECONDS=30

# ---- Image object storage (SeaweedFS S3) ----
# Multi-replica deployments (compose with api>1, k3s) MUST enable S3: with local
# disk each api instance only sees the files uploaded through itself.
# Leave disabled (default) for single-instance local dev; images then live in
# each container's MEDIA_DIR and do not survive container recreation.
# Real access keys go into your .env (gitignored) / K8s Secret - never commit them.
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=eventpulse
S3_ACCESS_KEY=
S3_SECRET_KEY=
# SeaweedFS uses path-style URLs (https://endpoint/bucket/key).
S3_PATH_STYLE=true
# Browser-direct image URLs. Set ONLY if the bucket grants anonymous
# s3:GetObject (bucket policy, objects only - never s3:ListBucket). Images are
# then served straight from object storage and their bytes never pass through
# the api. Leave empty to keep serving them via /api/media/images/{id}.
S3_PUBLIC_BASE_URL=
