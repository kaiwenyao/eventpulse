# Copy to .env and adjust. Rotating these two secrets invalidates issued tokens.
# In prod profile both are mandatory and dev defaults are refused at startup.
SECRET_KEY=change-me-please-32-bytes-minimum-secret!!
DB_PASSWORD=eventpulse
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI service (Python, FastAPI + LangChain) ----
# Set a real LLM key to enable the AI assistant; without it every AI endpoint
# answers "AI unavailable" and normal business flows keep working.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional OpenAI-compatible endpoint override:
# MUST include the API prefix (e.g. https://host/v1); ai-service calls
# {LLM_BASE_URL}/chat/completions. Leave empty to use the default OpenAI API.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# Reasoning models spend thinking tokens from this budget; keep it >= 4096.
LLM_MAX_OUTPUT_TOKENS=4096
# Spring Boot <-> ai-service mutual credentials (change in real deployments):
AI_SERVICE_TOKEN=dev-ai-service-token
AI_INTERNAL_TOKEN=dev-ai-internal-token
AI_ENABLED=true
