# Copy to .env and adjust. Rotating these two secrets invalidates issued tokens.
# In prod profile both are mandatory and dev defaults are refused at startup.
SECRET_KEY=change-me-please-32-bytes-minimum-secret!!
TOKEN_PEPPER=change-me-please-32-bytes-minimum-pepper!!
DB_PASSWORD=eventpulse
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Demo-only payment gateway scenario rules (server-side, matched by provider-key
# prefix): "prefix:SCENARIO:seconds;..." with scenarios SUCCESS, FAILURE,
# LATE_SUCCESS, UNKNOWN_THEN_SUCCESS, UNKNOWN_THEN_FAILURE, ALWAYS_UNKNOWN.
# Leave empty for an always-success gateway. The prod profile refuses to start
# with a non-empty value.
GATEWAY_SCENARIO_RULES=
