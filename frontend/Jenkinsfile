// EventPulse frontend CI — modeled on dublin-bikes/frontend/Jenkinsfile.
// Kubernetes cloud agent (Jenkins kubernetes-plugin injects the jnlp sidecar):
//   - node:  install deps, lint, unit tests + coverage, production build, Playwright smoke.
//   - docker: on main, build & push ghcr.io/<user>/eventpulse-frontend:<short-sha>
//     (same tagging as nightdeal: commit short SHA, no latest).
//
// Cluster assumptions: cloud name `kubernetes`, and a Docker-enabled node
// exposing /var/run/docker.sock (needed only for the image-build stage).
pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            defaultContainer 'node'
            // -----------------------------------------------------------------------------
            // Pod definition. Two workload containers (node + docker); Jenkins injects jnlp.
            //
            // node container: npm ci, ESLint, Vitest unit tests (jsdom, no backend needed),
            // production build, Playwright chromium smoke (installs OS deps on first run).
            // docker container: docker:27-cli is Alpine and has /bin/sh; on main it
            // talks to the host-node daemon through the mounted socket to build and
            // push ghcr.io/<user>/eventpulse-frontend:<short-sha>.
            // -----------------------------------------------------------------------------
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label: eventpulse-frontend-build
spec:
  containers:
    - name: node
      image: node:24-slim
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "500m"
          memory: 2Gi
        limits:
          cpu: "2000m"
          memory: 4Gi
    - name: docker
      image: docker:27-cli
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "100m"
          memory: 128Mi
        limits:
          cpu: "500m"
          memory: 256Mi
      volumeMounts:
        - mountPath: /var/run/docker.sock
          name: docker-sock
  volumes:
    - name: docker-sock
      hostPath:
        path: /var/run/docker.sock
'''
        }
    }

    options {
        skipDefaultCheckout()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    environment {
        CI = 'true'
    }

    stages {
        stage('1. Pull Code') {
            steps {
                checkout scm
            }
        }

        stage('Frontend CI') {
            when {
                anyOf {
                    changeset pattern: 'frontend/**'
                    changeset pattern: 'deploy/frontend/**'
                    triggeredBy 'UserIdCause'
                }
            }
            stages {
                stage('2. Install & Lint') {
                    steps {
                        container('node') {
                            dir('frontend') {
                                sh '''
                                node --version
                                npm --version
                                npm ci
                                npm run lint
                                '''
                            }
                        }
                    }
                }

                stage('3. Unit Tests & Coverage') {
                    steps {
                        container('node') {
                            dir('frontend') {
                                sh '''
                                # Vitest jsdom unit tests with coverage (enforces the thresholds
                                # configured in vite.config.ts). No backend or browser needed.
                                npm run coverage
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'frontend/coverage/**', allowEmptyArchive: true
                        }
                    }
                }

                stage('4. Build') {
                    steps {
                        container('node') {
                            dir('frontend') {
                                sh '''
                                # npm run build runs `tsc -b && vite build`.
                                npm run build
                                '''
                            }
                        }
                    }
                }

                stage('5. Playwright Smoke') {
                    steps {
                        container('node') {
                            dir('frontend') {
                                sh '''
                                # Same gate as .github/workflows/ci.yml: Chromium against the
                                # Vite dev server (no backend). --with-deps installs the OS
                                # libraries node:24-slim does not ship.
                                npx playwright install --with-deps chromium
                                npm run e2e
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'frontend/playwright-report/**', allowEmptyArchive: true
                        }
                    }
                }

            }
        }

        stage('6. Build & Push Image') {
            when {
                branch 'main'
            }
            steps {
                container('docker') {
                    script {
                        // Shared with nightdeal / vimpaste: usernamePassword `ghcr-token`
                        // (GitHub user + classic PAT with write:packages). Tag is the
                        // commit short SHA — immutable, no `latest`.
                        withCredentials([usernamePassword(credentialsId: 'ghcr-token', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_PASS')]) {
                            def gitCommit = (env.GIT_COMMIT ?: '').trim()
                            if (!(gitCommit ==~ /^[0-9a-f]{7,40}$/)) {
                                error("GIT_COMMIT is missing or invalid (got: ${gitCommit})")
                            }
                            env.FULL_IMAGE = "ghcr.io/${env.GHCR_USER.toLowerCase()}/eventpulse-frontend:${gitCommit.take(7)}"
                            echo "Pushing ${env.FULL_IMAGE}"
                            sh 'echo "$GHCR_PASS" | docker login ghcr.io -u "$GHCR_USER" --password-stdin'
                            sh '''
                            # Build context is the repo root (matches docker-compose.yml).
                            docker build -f deploy/frontend/Dockerfile -t "$FULL_IMAGE" .
                            docker push "$FULL_IMAGE"
                            '''
                            sh 'docker logout ghcr.io'
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
