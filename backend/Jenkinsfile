// EventPulse backend CI — modeled on dublin-bikes/backend/Jenkinsfile.
// Kubernetes cloud agent (Jenkins kubernetes-plugin injects the jnlp sidecar):
//   - maven: tests (unit + Testcontainers ITs), coverage and packaging in one verify invocation.
//   - docker: on main, build & push ghcr.io/<user>/eventpulse-backend:<short-sha>
//     (same tagging as nightdeal: commit short SHA, no latest).
//   - gitops: after a successful main image push, update k3s-home/main.
//
// Cluster assumptions: cloud name `kubernetes`, writable node-local cache storage,
// and a Docker-enabled node exposing /var/run/docker.sock (not plain containerd).
pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            defaultContainer 'maven'
            // -----------------------------------------------------------------------------
            // Pod definition. Three workload containers (maven + docker + gitops); Jenkins injects jnlp.
            //
            // maven container (image has JDK 21 + Maven):
            //   - TESTCONTAINERS_HOST_OVERRIDE: the BookingConcurrencyIT uses Testcontainers.
            //     Testcontainers assumes localhost, but the daemon socket is mounted from the
            //     host node and the Pod has its own network namespace — localhost would be the
            //     Pod itself. status.hostIP (Downward API) tells it to reach back via the node.
            //   - TESTCONTAINERS_RYUK_DISABLED: Ryuk needs --privileged, which restricted
            //     clusters usually cannot pull off; falls back to JVM shutdown hooks, and
            //     post { always } removes leftover postgres:18-alpine Testcontainers.
            //   - Mounted volumes: node-local persistent Maven cache shared by Java jobs,
            //     and the host-node Docker socket for Testcontainers.
            //
            // docker container (docker:27-cli is Alpine and has /bin/sh):
            //   - on main, builds and pushes the backend image to GHCR.
            // -----------------------------------------------------------------------------
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label: eventpulse-backend-build
spec:
  containers:
    - name: maven
      image: maven:3.9-eclipse-temurin-21
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "500m"
          memory: 2Gi
        limits:
          cpu: "2000m"
          memory: 4Gi
      env:
        # Tell Testcontainers which address to use to reach the containers it spawns.
        # The daemon runs on the host node (socket mount), the Pod has its own network
        # namespace, so localhost would resolve to the Pod, not the node.
        - name: TESTCONTAINERS_HOST_OVERRIDE
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        # Ryuk cannot run in restricted clusters (needs --privileged); the JVM shutdown
        # hook cleans up instead, post { always } is the safety net.
        - name: TESTCONTAINERS_RYUK_DISABLED
          value: "true"
      volumeMounts:
        # Keep dependency resolution and JAR reads off NFS. The Maven image runs as root.
        # All jobs sharing this repository must use the same cross-process lock settings.
        - mountPath: /var/cache/maven/repository
          name: maven-repo
        # Host-node Docker socket: Testcontainers needs it to run the PostgreSQL container.
        - mountPath: /var/run/docker.sock
          name: docker-sock
    - name: docker
      image: docker:27-cli
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "100m"
          memory: 128Mi
        limits:
          cpu: "500m"
          memory: 256Mi
      volumeMounts:
        - mountPath: /var/run/docker.sock
          name: docker-sock
    - name: gitops
      # Same Git tooling and credentials as nightdeal; no Docker socket needed.
      image: alpine:3.22
      command:
        - sh
        - -c
      args:
        - apk add --no-cache git ca-certificates && sleep 9999999
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "100m"
          memory: 128Mi
        limits:
          cpu: "500m"
          memory: 256Mi
  volumes:
    # Survives Pod deletion; each node warms its own cache on first use.
    - name: maven-repo
      hostPath:
        path: /var/cache/jenkins/maven/repository
        type: DirectoryOrCreate
    - name: docker-sock
      hostPath:
        path: /var/run/docker.sock
'''
        }
    }

    options {
        skipDefaultCheckout()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        skipStagesAfterUnstable()
        // Serialize builds of this job; Maven file locks coordinate the shared repository
        // with other branches and projects (which this option does not serialize).
        disableConcurrentBuilds()
    }

    environment {
        CI = 'true'
    }

    stages {
        stage('1. Pull Code') {
            steps {
                checkout scm
            }
        }

        stage('Backend CI') {
            when {
                anyOf {
                    changeset pattern: 'backend/**'
                    changeset pattern: 'deploy/backend/**'
                    changeset pattern: 'pom.xml'
                    triggeredBy 'UserIdCause'
                }
            }
            stages {
                stage('2. Maven Verify') {
                    environment {
                        // Integration tests otherwise inherit the application's SQL DEBUG default.
                        SQL_LOG_LEVEL = 'WARN'
                    }
                    steps {
                        container('maven') {
                            dir('backend') {
                                // One lifecycle runs unit/IT tests, generates the coverage
                                // report, packages the JAR and enforces the coverage gate.
                                sh '''
                                set -eu
                                java -version
                                maven_repo="/var/cache/maven/repository"
                                mkdir -p "$maven_repo"
                                echo "Maven repository: $maven_repo (node-local, shared across Java jobs)"
                                started_at=$(date +%s)
                                trap 'echo "Maven verify elapsed: $(($(date +%s) - started_at))s"' EXIT
                                # Every writer must use file-lock + file-gav so downloads
                                # and metadata updates are coordinated across Maven JVMs.
                                mvn -B -ntp -Dmaven.repo.local="$maven_repo" \\
                                    -Daether.syncContext.named.factory=file-lock \\
                                    -Daether.syncContext.named.nameMapper=file-gav \\
                                    -Dmaven.test.redirectTestOutputToFile=true \\
                                    -DenableOutErrElements=false verify
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            // Archive before publishing JUnit, even when tests/coverage fail.
                            // Detailed test output stays downloadable instead of flooding the UI.
                            container('maven') {
                                dir('backend') {
                                    sh '''
                                    if [ -d target/surefire-reports ]; then
                                        tar -czf target/backend-test-logs.tar.gz -C target surefire-reports
                                        echo "Detailed test logs: backend/target/backend-test-logs.tar.gz (build artifacts)"
                                    fi
                                    '''
                                }
                            }
                            archiveArtifacts artifacts: 'backend/target/backend-test-logs.tar.gz', allowEmptyArchive: true
                            junit testResults: 'backend/target/surefire-reports/*.xml', allowEmptyResults: false, keepLongStdio: false
                        }
                    }
                }

                stage('3. Publish Coverage') {
                    steps {
                        archiveArtifacts artifacts: 'backend/target/site/jacoco/**', allowEmptyArchive: false
                        script {
                            try {
                                publishHTML(target: [
                                    reportName: 'JaCoCo Coverage',
                                    reportDir: 'backend/target/site/jacoco',
                                    reportFiles: 'index.html',
                                    keepAll: true,
                                    alwaysLinkToLastBuild: true,
                                    allowMissing: false
                                ])
                            } catch (Throwable err) {
                                echo "publishHTML skipped (HTML Publisher plugin not installed?): ${err}"
                            }
                        }
                    }
                }

            }
        }

        stage('6. Build & Push Image') {
            when {
                branch 'main'
            }
            steps {
                container('docker') {
                    script {
                        // Shared with nightdeal / vimpaste: usernamePassword `ghcr-token`
                        // (GitHub user + classic PAT with write:packages). Tag is the
                        // commit short SHA — immutable, no `latest`.
                        withCredentials([usernamePassword(credentialsId: 'ghcr-token', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_PASS')]) {
                            def gitCommit = (env.GIT_COMMIT ?: '').trim()
                            if (!(gitCommit ==~ /^[0-9a-f]{7,40}$/)) {
                                error("GIT_COMMIT is missing or invalid (got: ${gitCommit})")
                            }
                            env.FULL_IMAGE = "ghcr.io/${env.GHCR_USER.toLowerCase()}/eventpulse-backend:${gitCommit.take(7)}"
                            echo "Pushing ${env.FULL_IMAGE}"
                            sh 'echo "$GHCR_PASS" | docker login ghcr.io -u "$GHCR_USER" --password-stdin'
                            dir('backend') {
                                sh '''
                                # Build context is backend/ (matches docker-compose.yml).
                                docker build -f ../deploy/backend/Dockerfile -t "$FULL_IMAGE" .
                                docker push "$FULL_IMAGE"
                                '''
                            }
                            sh 'docker logout ghcr.io'
                        }
                    }
                }
            }
        }

        stage('7. Update k3s-home') {
            when {
                branch 'main'
            }
            steps {
                container('gitops') {
                    withCredentials([usernamePassword(
                        credentialsId: 'k3s-home-write',
                        usernameVariable: 'GITOPS_USER',
                        passwordVariable: 'GITOPS_TOKEN'
                    )]) {
                        sh 'sh scripts/update-k3s-home.sh backend'
                    }
                }
            }
        }
    }

    post {
        always {
            // Safety net: remove Testcontainers leftovers from a cancelled/killed IT
            // (Ryuk is disabled). Limit to this suite's image so we do not rm every
            // Testcontainers container on a shared node.
            script {
                try {
                    container('docker') {
                        sh '''
                            echo "Cleaning up leftover Testcontainers PostgreSQL containers"
                            stray=$(docker ps -aq \
                                --filter "label=org.testcontainers=true" \
                                --filter "ancestor=postgres:18-alpine" || true)
                            if [ -n "$stray" ]; then
                                docker rm -f $stray || true
                            else
                                echo "No stray containers found"
                            fi
                        '''
                    }
                } catch (err) {
                    echo "Testcontainers cleanup skipped: ${err}"
                }
            }
            cleanWs()
        }
    }
}
